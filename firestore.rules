rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Tarjeta pública de cada jugador (nombre, avatar, puntos semanales)
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Duelos 1 contra 1
    match /duels/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.p;
      allow create: if request.auth != null && request.resource.data.a == request.auth.uid
                    && request.resource.data.p == [request.auth.uid, request.resource.data.b]
                    && request.resource.data.as == null && request.resource.data.bs == null;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.a && resource.data.as == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['as']))
        || (request.auth.uid == resource.data.b && resource.data.bs == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bs']))
        || (request.auth.uid == resource.data.b && resource.data.bs == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rej'])));
    }
    // Solicitudes de amistad (id = from_to)
    match /freq/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.to
                    && request.resource.data.st == 'p';
      allow update: if request.auth != null && request.auth.uid == resource.data.to
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','tn']);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }
    // Códigos de un solo uso: solo se puede crear la marca una vez
    match /codesUsed/{h} {
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
    }
    // Amistades (id = uidA_uidB ordenados), m = [uidA, uidB]
    match /fs/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.m;
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && request.resource.data.m.size() == 2 && request.auth.uid in request.resource.data.m
                    && request.resource.data.m[0] < request.resource.data.m[1]
                    && id == request.resource.data.m[0] + '_' + request.resource.data.m[1]
                    && request.resource.data.st == 'p';
      allow update: if request.auth != null && request.auth.uid in resource.data.m
                    && request.auth.uid != resource.data.from && resource.data.st == 'p'
                    && request.resource.data.st == 'a'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','tn']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.m;
    }
    // Grupos: cualquiera con sesión puede leer, crear y unirse/salir (solo cambiando "members")
    match /groups/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }
  }
}
